# Copia este fichero como .env y rellena tu API key. El .env está en .gitignore.

# Proveedor del LLM: gemini (por defecto) u openai
LLM_PROVIDER=gemini

# API key del proveedor elegido (solo hace falta una)
GEMINI_API_KEY=pega-aqui-tu-api-key-de-google-ai-studio
# OPENAI_API_KEY=sk-...

# --- Opcional: sobrescribir los valores por defecto -----------------------
# LLM_MODEL=gemini-3.5-flash-lite        # modelo principal del chat
# LLM_UTILITY_MODEL=gemini-3.1-flash-lite # reescritura de consultas, resúmenes, fotos
# LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-26b-a4b-it  # si se agota la cuota diaria
# LLM_TEMPERATURE=1.0
# LLM_TOP_P=0.95
# LLM_MAX_TOKENS=2048
# LLM_REASONING_EFFORT=low
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# WEATHER_MODE=live                       # live (Open-Meteo) o mock (simulado, sin red)
